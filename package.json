{
  "name": "abnormal-ui",
  "version": "0.1.0",
  "private": true,
  "description": "The Abnormal shadcn registry: design tokens, base components and brand pieces shared by the website, onboard and mail.",
  "type": "module",
  "scripts": {
    "build": "shadcn build",
    "serve": "pnpm build && wrangler dev --port 4341",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test tests/*.test.ts",
    "check": "pnpm typecheck && pnpm test && pnpm format:check",
    "cf:deploy": "pnpm build && wrangler deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.64.0",
    "next-themes": "^0.4.6",
    "prettier": "^3.9.10",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "typescript": "^6.0.3",
    "wrangler": "^4.156.0"
  },
  "packageManager": "pnpm@12.16.1"
}
