{
  "name": "abnormal-ui",
  "version": "0.1.0",
  "private": true,
  "description": "The Abnormal shadcn registry: design tokens, base components and brand pieces shared by the website, onboard and mail.",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 4342",
    "build:registry": "shadcn build",
    "build": "pnpm build:registry && next build",
    "serve": "pnpm build && wrangler dev --port 4341",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "pnpm build && node --import ./tests/support/register.ts --test tests/*.test.ts tests/*.test.tsx",
    "check": "pnpm typecheck && pnpm test",
    "cf:build": "pnpm check && pnpm format:check && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "cf:deploy": "wrangler deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@shikijs/langs": "^4.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.64.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "prettier": "^3.9.10",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.156.0"
  },
  "packageManager": "pnpm@12.16.1"
}
