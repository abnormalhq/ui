{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abnormal-ui",
  "compatibility_date": "2026-09-01",
  // Everything is a static asset. The Worker only picks a file for the pages, and renders nothing.
  "main": "src/worker.ts",
  "assets": {
    "directory": "out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/components/*", "!/components/*.txt"],
  },
  "workers_dev": true,
  "routes": [{ "pattern": "ui.abnormalhq.com", "custom_domain": true }],
}
