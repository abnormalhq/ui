{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abnormalhq-ui",
  "compatibility_date": "2026-09-01",
  // Everything is a static asset. The Worker only picks a file for the pages, and renders nothing.
  "main": "src/worker.ts",
  "assets": {
    "directory": "out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/",
      "/design",
      "/gallery",
      "/components/*",
      "!/components/*.txt",
      "/zh",
      "/zh/design",
      "/zh/gallery",
      "/zh/components/*",
      "!/zh/components/*.txt",
    ],
  },
  "workers_dev": true,
  "routes": [{ "pattern": "ui.abnormalhq.com", "custom_domain": true }],
  // Observability: logs and traces sample 10% of requests. Issues must be written here, or the next deploy turns off a switch enabled in the dashboard.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "redact_query_string": true,
    "issues": {
      "enabled": true,
    },
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
    },
  },
}
