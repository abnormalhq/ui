{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abnormal-ui",
  "compatibility_date": "2026-09-01",
  // No `main`: the exported site, the registry JSON and the fonts are all static assets, so no Worker code runs.
  "assets": {
    "directory": "out",
    "not_found_handling": "404-page",
  },
  "workers_dev": true,
  "routes": [{ "pattern": "ui.abnormalhq.com", "custom_domain": true }],
}
