{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static hosting only: the registry is the JSON that `shadcn build` writes to public/r, plus the font files.
  "name": "abnormal-ui",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public" },
  "workers_dev": true,
  "routes": [{ "pattern": "ui.abnormalhq.com", "custom_domain": true }],
}
